{
  "compilerOptions": {
    "target": "es2018",
    "module": "es2020",
    "moduleResolution": "bundler",
    "lib": ["es2018", "dom"],
    "types": ["mocha"],
    "strict": true,
    "noUnusedLocals": true,
    "skipLibCheck": true,
    "paths": {
      "@codemirror/lang-python": ["./src/python.ts"]
    }
  },
  "include": ["src/*.ts", "test/**/*.ts"]
}
